# lease check, which asserts no runtime state is tracked.
.dainexus/verify/
.dainexus/runtime/
.dainexus/escalations/
.dainexus/pipeline-state.json
.dainexus/leases.json
.dainexus/memory.db*
memory.db
.dainexus/logs/
.dainexus/audit/
.dainexus/metrics/
.dainexus/telemetry/
.dainexus/cache/
.dainexus/local-ci-venv/
.dainexus/mcp-server/node_modules/

# ─── Generated evidence & report artifacts ─────────────────────────────────
.dainexus/reports/
.dainexus/docs-hub/
.dainexus/guardrail-log.jsonl
.dainexus/policy-log.jsonl
.dainexus/rule-ledger.jsonl
.dainexus/quality-history.json
.dainexus/quality-gate-events.jsonl
.dainexus/verification-events.jsonl
.dainexus/quality-report-*.json
.dainexus/baseline-*.json
.dainexus/change-manifest-*.json
.dainexus/git-baseline.json
.dainexus/session-log.json
.dainexus/events.log
.dainexus/bookkeep.log
ruff_errors.json

# Workspace-local MCP runtime evidence
mcp/.dainexus/

# ─── Parallel dispatch worktrees ───────────────────────────────────────────
.worktrees/

# ─── Mutation-testing scratch ──────────────────────────────────────────────
.stryker-tmp/
mutants/
.mutmut-cache

# ─── Editor / tool scratch ─────────────────────────────────────────────────
.qoder/
_local_tmp_edits/

# NOTE on deliberate inclusions:
#   src/cli/dist/       tracked — the docs-continuity gate runs the built CLI
#   .claude/            tracked — tests/unit_tests/test_hook_schema.py reads the
#                       checked-in settings.json
#   *.xlsx              NOT ignored — skills/project-manager/excel-generator
#                       ships real spreadsheet templates
